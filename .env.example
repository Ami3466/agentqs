# ------------------------------------------------------------------
# agentqs environment
# Copy to .env (or .env.local) — every value here is optional.
# ------------------------------------------------------------------

# Where agentqs writes your config, record, and SQLite cache.
# Local default: ./data   ·   Docker default: /data (set in the image)
AGENTQS_DATA_DIR=./data

# Optional: override the signed-session secret. Auto-generated at
# /setup and stored in the data dir if left unset.
SESSION_SECRET=

# Optional: local ingestion listener.
AGENTQS_INGEST_PORT=
AGENTQS_INGEST_TOKEN=

# Optional: default LLM keys. You can also paste these in Settings.
# Anthropic API key used by the configured language model.
ANTHROPIC_API_KEY=
# OpenAI API key used by language models and voice transcription.
OPENAI_API_KEY=
# Google AI SDK key used by configured Gemini language models.
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini API key used by live voice and transcription routes.
GEMINI_API_KEY=
# Alternate Google API key used by Gemini voice and transcription routes.
GOOGLE_API_KEY=

# Semantic search ("find days that felt like this") needs NO configuration: it runs
# on a local embedding model + sqlite-vec, default-on, no key, no cost, offline. The
# index is a derived file next to the cache (data/agentqs-vec.db) and rebuilds itself.

# Optional: GitHub token for the commits/day importer. You can also paste this
# on the Data tab. A read-only fine-grained PAT (or classic `repo`) is enough.
GITHUB_TOKEN=

# Optional: Tier-1 plugin credentials. You can also paste each on the Data tab.
#   RescueTime — an API key (Settings → API in RescueTime).
RESCUETIME_KEY=
#   Google Calendar / Spotify — an OAuth 2 access token (a bearer token).
GCAL_TOKEN=
SPOTIFY_TOKEN=
WHOOP_API_TOKEN=
FITBIT_TOKEN=
OURA_TOKEN=
WITHINGS_TOKEN=
STRAVA_TOKEN=
SWARM_TOKEN=
#   Last.fm — an API key (not a bearer token).
LASTFM_KEY=
DEEZER_TOKEN=
TRAKT_TOKEN=
WAKATIME_KEY=
TODOIST_TOKEN=
TOGGL_TOKEN=
READWISE_TOKEN=
YNAB_TOKEN=
NOTION_TOKEN=
GMAIL_TOKEN=
GRANOLA_REFRESH_TOKEN=

# Optional: Notion export paths used by the journal import script.
AGENTQS_NOTION_JOURNAL=
AGENTQS_NOTION_TEXTS=
AGENTQS_NOTION_PAGES=

# Optional: Google Data Portability tokens used by its import test tool.
GOOGLE_PORTABILITY_TOKEN=
GOOGLE_PORTABILITY_API_KEY=

# Optional: local model directory override for embeddings and speech models.
AGENTQS_MODELS_DIR=
# Set to 1 to prevent model downloads and require local model files.
AGENTQS_MODELS_OFFLINE=
# Embedding batch size override for local indexing.
AGENTQS_EMBED_BATCH=
# Set to hash to use deterministic test embeddings instead of the local model.
AGENTQS_EMBED_BACKEND=
# Set to off to disable photo embeddings while keeping photo import enabled.
AGENTQS_PHOTO_EMBED=
# Idle milliseconds before an unused model is released from memory.
AGENTQS_MODEL_IDLE_MS=
# Set to 1 to log model-slot lifecycle diagnostics.
AGENTQS_MODEL_DEBUG=
# Set to 1 to disable the background scheduler.
AGENTQS_NO_SCHEDULER=
# Set to 1 to exercise the local Whisper path in the voice end-to-end test.
AGENTQS_WHISPER_E2E=
# Temporary credential consumed only by the synthetic pipeline test plugin.
AGENTQS_FAKEAPI_TOKEN=
# Alternate Next.js output directory used by build-backed test scripts.
NEXT_DIST_DIR=

# Optional: voice memo transcription (the global mic → your inbox).
#   WHISPER_BIN  — a local command that takes an audio file path and prints the
#                  transcript to stdout. Wrap whisper.cpp / faster-whisper / any
#                  engine. Preferred when set — private, no key, no cost.
#   WHISPER_ARGS — extra args passed before the audio path (optional).
#   With no WHISPER_BIN, agentqs uses OpenAI Whisper if an OpenAI key is available
#   (OPENAI_API_KEY, or your saved key when the provider is OpenAI).
WHISPER_BIN=
WHISPER_ARGS=
# WHISPER_MODEL=whisper-1   # OpenAI transcription model (default whisper-1)
WHISPER_MODEL=
# Gemini speech-to-text model override.
GEMINI_STT_MODEL=

# Optional: in-chat live voice session (ElevenLabs Conversational AI). Config-gated
# — the in-chat toggle stays a stub until BOTH are set. Keeps your chosen LLM as the
# brain (set the agent's LLM in the ElevenLabs dashboard); adds premium voice +
# turn-taking, and writes the session's key points back to your record.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Optional: messaging bots (Loop 14). Each channel is a webhook at
# /api/channels/<channel> that turns an inbound message into a memo (`>>`) or a
# grounded chat reply and posts it back out. Set a channel's token to enable it.
#
#   Telegram — create a bot with @BotFather, then point it at your instance:
#     curl "https://api.telegram.org/bot<token>/setWebhook?url=<host>/api/channels/telegram&secret_token=<secret>"
#   TELEGRAM_WEBHOOK_SECRET is optional but recommended — Telegram echoes it in a
#   header and agentqs rejects any webhook whose secret doesn't match.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_API_BASE=https://api.telegram.org   # override the Bot API host (tests/proxies)
TELEGRAM_API_BASE=
#
#   Slack — a bot token (xoxb-…) from your app's OAuth scopes, and the signing
#   secret so agentqs can verify each request. Point the Events API request URL at
#   <host>/api/channels/slack (Slack's url_verification handshake is handled).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# SLACK_API_BASE=https://slack.com/api          # override the Web API host (tests/proxies)
SLACK_API_BASE=
# Slack channel ID polled by the pull connector.
SLACK_PULL_CHANNEL=

# Port the server listens on (defaults to 3000)
PORT=
